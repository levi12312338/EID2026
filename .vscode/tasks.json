// Ablageort: .vscode/tasks.json
// Voraussetzung: ruff systemweit (kommt aus dem onCreateCommand der devcontainer.json)
// Läuft über das ganze Repo ("."), die Ausschlüsse (data, models, .venv, ...) kommen aus der pyproject.toml.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ruff Format",
      "type": "shell",
      // --unsafe-fixes entfernt: kann Verhalten des Codes ändern.
      "command": "ruff format . && ruff check . --fix",
      "problemMatcher": []
    }
  ]
}